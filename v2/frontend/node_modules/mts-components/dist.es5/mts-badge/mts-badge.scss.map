@import "../core/variables";
@import "../core/mixins";
@import "../core/cssreset";

section[class ^= "mts-badge"] {
    position: relative;

    & > span {
        font: 500 1.05em/1.5em $font-family;
        position: absolute;
        z-index: 1;
        top: -0.75em;
        right: -0.75em;
        width: 1.5em;
        height: 1.5em;
        text-align: center;
        color: white;
        border-radius: 50%;
        background-color: black;
    }

    /* colors*/

    &[class *= "--primary"] {

        span {
            background-color: $color-primary;
        }
    }

    &[class *= "--secondary"] {

        span {
            background-color: $color-secondary;
        }
    }

    &[class *= "--tertiary"] {

        span {
            background-color: $color-tertiary;
        }
    }

    &[class *= "--quaternary"] {

        span {
            background-color: $color-quaternary;
        }
    }

    &[class *= "--white"] {

        span {
            color: black;
            background-color: white;
        }
    }

    &[class *= "--grey"] {

        span {
            color: black;
            background-color: $border-color;
        }
    }
}
