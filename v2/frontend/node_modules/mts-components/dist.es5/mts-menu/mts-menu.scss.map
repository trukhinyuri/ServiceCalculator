@import "../core/variables";
@import "../core/mixins";
@import "../core/cssreset";

section.mts-menu {
    position: absolute;
    overflow: visible;
    width: 0;
    height: 0;

    ::slotted(*) {
        display: block;
    }

    /* ie11 hax start */
    @supports (-ms-ime-align:auto) {

        & > .menu > * {
            invalid-property: "forIe11andEdgeDirtyHax";
        }
    }

    /* ie11 hax end */

    & > .menu > * {
        display: block;
    }

    & > .back {
        position: fixed;
        z-index: 10000001;
        top: 0;
        left: 0;
        display: none;
        width: 100vw;
        height: 100vh;
    }

    & > .menu {
        position: relative;
        z-index: 10000002;
        display: none;
        overflow: auto;
        max-height: 35em;
        animation: $transition-primary;
        border-radius: $border-radius;
        background-color: white;
        box-shadow: 0 0.3em 0.9em rgba(0, 0, 0, 0.3);
        animation-fill-mode: forwards;

        &.open--left--top {
            transform: translate(-90%, -60%) scale(0.8, 0.2);
            animation-name: modal-open--left--top;
            opacity: 0;

            @keyframes modal-open--left--top {

                from {
                    transform: translate(-90%, -60%) scale(0.8, 0.2);
                    opacity: 0;
                }

                to {
                    transform: translate(-100%, -100%) scale(1);
                    opacity: 1;
                }
            }
        }

        &.open--center--top {
            transform: translate(-50%, -60%) scale(0.8, 0.2);
            animation-name: modal-open--center--top;
            opacity: 0;

            @keyframes modal-open--center--top {

                from {
                    transform: translate(-50%, -60%) scale(0.8, 0.2);
                    opacity: 0;
                }

                to {
                    transform: translate(-50%, -100%) scale(1);
                    opacity: 1;
                }
            }
        }

        &.open--right--top {
            transform: translate(-10%, -60%) scale(0.8, 0.2);
            animation-name: modal-open--right--top;
            opacity: 0;

            @keyframes modal-open--right--top {

                from {
                    transform: translate(-10%, -60%) scale(0.8, 0.2);
                    opacity: 0;
                }

                to {
                    transform: translate(0, -100%) scale(1);
                    opacity: 1;
                }
            }
        }

        &.open--left--middle {
            transform: translate(-50%, -50%) scale(0.8, 0.2);
            animation-name: modal-open--left--middle;
            opacity: 0;

            @keyframes modal-open--left--middle {

                from {
                    transform: translate(-50%, -50%) scale(0.8, 0.2);
                    opacity: 0;
                }

                to {
                    transform: translate(-100%, -50%) scale(1);
                    opacity: 1;
                }
            }
        }

        &.open--center--middle {
            transform: translate(-50%, -50%) scale(0.8, 0.2);
            animation-name: modal-open--center--middle;
            opacity: 0;

            @keyframes modal-open--center--middle {

                from {
                    transform: translate(-50%, -50%) scale(0.8, 0.2);
                    opacity: 0;
                }

                to {
                    transform: translate(-50%, -50%) scale(1);
                    opacity: 1;
                }
            }
        }

        &.open--right--middle {
            transform: translate(-50%, -50%) scale(0.2, 0.6);
            animation-name: modal-open--right--middle;
            opacity: 0;

            @keyframes modal-open--right--middle {

                from {
                    transform: translate(-50%, -50%) scale(0.2, 0.6);
                    opacity: 0;
                }

                to {
                    transform: translate(0, -50%) scale(1);
                    opacity: 1;
                }
            }
        }

        &.open--left--bottom {
            transform: translate(-90%, -40%) scale(0.8, 0.2);
            animation-name: modal-open--left--bottom;
            opacity: 0;

            @keyframes modal-open--left--bottom {

                from {
                    transform: translate(-90%, -40%) scale(0.8, 0.2);
                    opacity: 0;
                }

                to {
                    transform: translate(-100%, 0%) scale(1);
                    opacity: 1;
                }
            }
        }

        &.open--center--bottom {
            transform: translate(-50%, -40%) scale(0.8, 0.2);
            animation-name: modal-open--center--bottom;
            opacity: 0;

            @keyframes modal-open--center--bottom {

                from {
                    transform: translate(-50%, -40%) scale(0.8, 0.2);
                    opacity: 0;
                }

                to {
                    transform: translate(-50%, 0) scale(1);
                    opacity: 1;
                }
            }
        }

        &.open--right--bottom {
            transform: translate(-10%, -40%) scale(0.8, 0.2);
            animation-name: modal-open--right--bottom;
            opacity: 0;

            @keyframes modal-open--right--bottom {

                from {
                    transform: translate(-10%, -40%) scale(0.8, 0.2);
                    opacity: 0;
                }

                to {
                    transform: translate(0, 0) scale(1);
                    opacity: 1;
                }
            }
        }

        &.close--left--top {
            transform: translate(-100%, -100%) scale(1);
            animation-name: modal-close--left--top;
            opacity: 1;

            @keyframes modal-close--left--top {

                from {
                    transform: translate(-100%, -100%) scale(1);
                    opacity: 1;
                }

                to {
                    transform: translate(-90%, -60%) scale(0.8, 0.2);
                    opacity: 0;
                }
            }
        }

        &.close--center--top {
            transform: translate(-50%, -100%) scale(1);
            animation-name: modal-close--center--top;
            opacity: 1;

            @keyframes modal-close--center--top {

                from {
                    transform: translate(-50%, -100%) scale(1);
                    opacity: 1;
                }

                to {
                    transform: translate(-50%, -60%) scale(0.8, 0.2);
                    opacity: 0;
                }
            }
        }

        &.close--right--top {
            transform: translate(0, -100%) scale(1);
            animation-name: modal-close--right--top;
            opacity: 1;

            @keyframes modal-close--right--top {

                from {
                    transform: translate(0, -100%) scale(1);
                    opacity: 1;
                }

                to {
                    transform: translate(-10%, -60%) scale(0.8, 0.2);
                    opacity: 0;
                }
            }
        }

        &.close--left--middle {
            transform: translate(-100%, -50%) scale(1);
            animation-name: modal-close--left--middle;
            opacity: 1;

            @keyframes modal-close--left--middle {

                from {
                    transform: translate(-100%, -50%) scale(1);
                    opacity: 1;
                }

                to {
                    transform: translate(-50%, -50%) scale(0.8, 0.2);
                    opacity: 0;
                }
            }
        }

        &.close--center--middle {
            transform: translate(-50%, -50%) scale(1);
            animation-name: modal-close--center--middle;
            opacity: 1;

            @keyframes modal-close--center--middle {

                from {
                    transform: translate(-50%, -50%) scale(1);
                    opacity: 1;
                }

                to {
                    transform: translate(-50%, -50%) scale(0.8, 0.2);
                    opacity: 0;
                }
            }
        }

        &.close--right--middle {
            transform: translate(0, -50%) scale(1);
            animation-name: modal-close--right--middle;
            opacity: 1;

            @keyframes modal-close--right--middle {

                from {
                    transform: translate(0, -50%) scale(1);
                    opacity: 1;
                }

                to {
                    transform: translate(-50%, -50%) scale(0.2, 0.6);
                    opacity: 0;
                }
            }
        }

        &.close--left--bottom {
            transform: translate(-100%, 0%) scale(1);
            animation-name: modal-close--left--bottom;
            opacity: 1;

            @keyframes modal-close--left--bottom {

                from {
                    transform: translate(-100%, 0%) scale(1);
                    opacity: 1;
                }

                to {
                    transform: translate(-90%, -40%) scale(0.8, 0.2);
                    opacity: 0;
                }
            }
        }

        &.close--center--bottom {
            transform: translate(-50%, 0) scale(1);
            animation-name: modal-close--center--bottom;
            opacity: 1;

            @keyframes modal-close--center--bottom {

                from {
                    transform: translate(-50%, 0) scale(1);
                    opacity: 1;
                }

                to {
                    transform: translate(-50%, -40%) scale(0.8, 0.2);
                    opacity: 0;
                }
            }
        }

        &.close--right--bottom {
            transform: translate(0, 0) scale(1);
            animation-name: modal-close--right--bottom;
            opacity: 1;

            @keyframes modal-close--right--bottom {

                from {
                    transform: translate(0, 0) scale(1);
                    opacity: 1;
                }

                to {
                    transform: translate(-10%, -40%) scale(0.8, 0.2);
                    opacity: 0;
                }
            }
        }
    }
}
