@import "../core/variables";
@import "../core/mixins";
@import "../core/cssreset";

section.mts-dialog {

    &.hidden {
        display: none;
    }

    & > [class ^= "back"] {
        position: fixed;
        z-index: 1000000;
        top: 0;
        left: 0;
        display: flex;
        width: 100%;
        height: 100%;
        animation-duration: 0.35s;
        background-color: rgba(0, 0, 0, 0.75);
        align-items: center;
        justify-content: center;
        animation-fill-mode: forwards;

        &[class *= "--open"] {
            animation-name: modal-background-open;
            animation-timing-function: ease-out;
            opacity: 0;

            @keyframes modal-background-open {

                from {
                    opacity: 0;
                }

                to {
                    opacity: 1;
                }
            }
        }

        &[class *= "--close"] {
            animation-name: modal-background-close;
            animation-timing-function: ease-in;
            opacity: 1;

            @keyframes modal-background-close {

                from {
                    opacity: 1;
                }

                to {
                    opacity: 0;
                }
            }
        }

        & > [class ^= "dialog"] {
            position: relative;
            animation-duration: 0.25s;
            background-color: white;
            box-shadow: 0 0.8em 2em rgba(0, 0, 0, 0.25);
            animation-fill-mode: forwards;
            border-radius: $border-radius;
            max-width: 96vw;

            &[class *= "--open"] {
                transform: scale(1.2);
                animation-name: modal-open;
                animation-timing-function: ease-out;
                animation-delay: 0.15s;
                opacity: 0;

                @keyframes modal-open {

                    from {
                        transform: scale(1.2);
                        opacity: 0;
                    }

                    to {
                        transform: scale(1);
                        opacity: 1;
                    }
                }
            }

            &[class *= "--close"] {
                transform: scale(1);
                animation-name: modal-close;
                animation-timing-function: ease-in;
                animation-delay: 0.15s;
                opacity: 1;

                @keyframes modal-close {

                    from {
                        transform: scale(1);
                        opacity: 1;
                    }

                    to {
                        transform: scale(0.8);
                        opacity: 0;
                    }
                }
            }

            & > .close {
                position: absolute;
                top: -0.2em;
                right: -3em;
                width: 2em;
                height: 2em;
                padding: 0;
                margin: 0;
                cursor: pointer;
                border: none;
                outline: none;
                background-color: transparent;

                svg {
                    fill: white;
                    width: 2em;
                    height: 2em;
                }

                @media (max-width: $smallScreen) {
                    right: 0.5em;
                    top: 0.5em;

                    svg {
                        fill: #888;
                    }
                }
            }
        }
    }
}
