@import "../core/variables";
@import "../core/mixins";
@import "../core/cssreset";
@import "./../core/mixins";

section.mts-picker {
    @include text-field();

    & > label {

        & > .field-input {
            padding-right: 3em;
        }

        &[disabled] {

            & > svg {
                display: none;
            }
        }

        & > svg {
            position: relative;
            top: 0;
            float: right;
            box-sizing: border-box;
            width: 3em;
            height: 3em;
            margin: 0 0 -3em 0;
            padding: 0.5em;
            cursor: pointer;
            transition: opacity $transition-primary, fill $transition-primary;
            fill: $border-color;

            &:hover {
                fill: #bbc1c7;
            }
        }

        & > mts-menu,
        & > mts-menu > section.mts-menu > .menu {

            & > div {
                box-sizing: border-box;
                width: 19.5em;
                padding: 0 1em;

                &:last-of-type {
                    padding-bottom: 0.8em;
                }
            }

            & > .date-picker,
            & > .year-picker {

                & > .month-line {
                    box-sizing: border-box;
                    text-align: center;

                    & > div {
                        @include font(1.3em);

                        display: inline-block;
                        box-sizing: border-box;
                        margin: 0;
                        padding: 0;
                        cursor: pointer;
                        transition: color $transition-primary;
                    }

                    & > .left,
                    & > .right {
                        width: 20%;
                        padding: 1em 0;
                        user-select: none;
                        vertical-align: middle;

                        &:hover {

                            & > span {
                                background-color: $border-color;
                            }
                        }

                        & > span {
                            font-size: 1.2em;
                            line-height: 1.3em;
                            display: inline-block;
                            width: 1.4em;
                            height: 1.4em;
                            transition: background-color $transition-primary;
                            text-align: center;
                            color: darken($border-color, 50%);
                            border-radius: 50%;
                            background-color: lighten($border-color, 4%);
                        }
                    }

                    & > .month {
                        cursor: default;
                        width: 35%;
                        padding: 1em 0.1em 1em 0;
                        text-align: right;
                        vertical-align: middle;

                        &:hover {
                            /*color: $color-primary;*/
                        }
                    }

                    & > .year {
                        width: 20%;
                        padding: 1em 0 1em 0.1em;
                        text-align: left;
                        vertical-align: middle;

                        &:hover {
                            color: $color-primary;
                        }
                    }

                    & > .year-range {
                        width: 55%;
                        padding: 1em 0;
                        vertical-align: middle;
                        pointer-events: none;
                    }
                }

                & > .days,
                & > .years {
                    padding-top: 0.5em;
                }

                & > .days-of-week,
                & > .days,
                & > .years {
                    box-sizing: border-box;
                    text-align: center;

                    & > div {
                        @include font(1em);

                        display: inline-block;
                        box-sizing: border-box;
                        width: 100% / 7 - 0.01;
                        margin: 0.15em 0;
                        padding: 0.6em 0;
                        cursor: pointer;
                        transition: color $transition-primary, background-color $transition-primary;
                        text-align: center;
                        border-radius: 50%;

                        &:hover {
                            color: $color-primary;
                        }

                        &.grey {
                            color: $border-color;

                            &:hover {
                                color: $color-primary;
                            }
                        }

                        &.highlighted {
                            border-radius: 50%;
                            background-color: lighten($border-color, 4%);
                        }

                        &.selected {
                            color: white;
                            border-radius: 50%;
                            background-color: $color-primary;
                        }
                    }
                }

                & > .days-of-week {

                    & > div {
                        font-size: 0.9em;
                        padding: 0.6em 0 0;
                    }
                }

                & > .years {

                    & > div {
                        width: 33%;
                        padding: 1.3em;
                    }
                }
            }

            & > .time-picker {
                text-align: center;

                & > div {
                    display: inline-block;
                    box-sizing: border-box;
                    width: 35%;
                    margin: 2%;

                    & > .up,
                    & > .down {
                        font-size: 1.6em;
                        box-sizing: border-box;
                        padding-left: 0.3em;
                        cursor: pointer;
                        transition: background-color $transition-primary;
                        color: #888;

                        &:after {
                            font-size: 1.1em;
                            display: inline-block;
                            content: "‹";
                            transform: rotate(90deg);
                        }

                        &:hover {
                            background-color: #eee;
                        }
                    }

                    & > .down {

                        &:after {
                            content: "›";
                        }
                    }

                    & > input {
                        font: 500 1.1em/1.3em $font-family;
                        box-sizing: border-box;
                        width: 100%;
                        padding: 0.4em 0.4em;
                        text-align: center;
                        color: #333;
                        border: 2px solid $border-color;
                        border-radius: $border-radius-small;
                        outline: none;
                        background: white;
                        box-shadow: none;
                    }
                }
            }

            & > .year-picker {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: white;
            }
        }
    }
}
