  "scripts": {
    "build": "rm -rvf ./dist/ && rm -rvf ./dist.es5/ && concurrently \"npm run build:styles\" \"npm run build:scripts\" && concurrently \"npm run build:intrinsics\" \"npm run build:bundle_component_es5\" \"npm run build:bundle_icons_es5\" \"npm run build:bundle_polyfill_es5\" \"npm run build:bundle_serviceworker\"",
    "build:bundle_component_es5": "rollup --config --environment NODE_ENV:production,APP:Component_es5",
    "build:bundle_icons_es5": "rollup --config --environment NODE_ENV:production,APP:Icons_es5",
    "build:bundle_polyfill_es5": "rollup --config --environment NODE_ENV:production,APP:Polyfill_es5",
    "build:bundle_serviceworker": "rollup --config --environment NODE_ENV:production,APP:Serviceworker",
    "build:intrinsics": "cp ./typings/jsx.d.ts ./dist/jsx-intrinsics.d.ts && sed -i 's/\\.\\.\\/src\\///g' ./dist/jsx-intrinsics.d.ts",
    "build:scripts": "concurrently \"tsc --project tsconfig.json\" \"tsc --project tsconfig.es5.json\"",
    "build:styles": "concurrently \"postcss ./src/**/*.scss --base ./src/ --dir ./dist/\" \"postcss ./src/**/*.scss --base ./src/ --dir ./dist.es5/\"",
    "cs": "concurrently \"npm run cs:tslint\" \"npm run cs:stylelint\"",
    "cs:stylelint": "stylelint --fix ./src/**/*.scss || exit 0",
    "cs:tslint": "tslint --fix --project ./tsconfig.json ./src/**/*.ts{,x}",
    "packages:fullupdate": "ncu -u && npm run packages:reinstall",
    "packages:manupdate": "rm -rvf node_modules && npm install",
    "packages:reinstall": "rm -rvf npm-shrinkwrap.json && rm -rvf node_modules && npm install && npm dedupe && npm prune && npm shrinkwrap",
    "prepublishOnly": "npm version patch && npm run cs && npm run build",
    "serve": "concurrently \"npm run build:styles\" \"npm run build:scripts\" && concurrently --kill-others \"npm run serve:browser-sync\" \"npm run serve:styles\" \"npm run serve:scripts\" \"npm run serve:bundle_component_es5\" \"npm run serve:bundle_icons_es5\"",
    "serve:browser-sync": "browser-sync start --config bs-config.js",
    "serve:bundle_component_es5": "rollup --config --watch --environment NODE_ENV:production,APP:Component_es5",
    "serve:bundle_icons_es5": "rollup --config --watch --environment NODE_ENV:production,APP:Icons_es5",
    "serve:scripts": "concurrently \"tsc --project tsconfig.json --watch --preserveWatchOutput\" \"tsc --project tsconfig.es5.json --watch --preserveWatchOutput\"",
    "serve:styles": "concurrently \"postcss ./src/**/*.scss --watch --base ./src/ --dir ./dist/\" \"postcss ./src/**/*.scss --watch --base ./src/ --dir ./dist.es5/\""
  },
  "types": "dist/index.d.ts",
  "version": "0.3.50"
