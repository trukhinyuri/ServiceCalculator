@import "../core/variables";
@import "../core/mixins";
@import "../core/cssreset";

section[class ^= "mts-chip"] {
    @include font(1.05em);

    padding: 0.25em 1em;
    border-radius: $border-radius-small;
    background-color: #eee;

    &[class *= "--clickable"] {
        cursor: pointer;
    }

    & > span:nth-child(1) {
        position: relative;
        top: -0.05em;
        left: -0.35em;
    }

    & > span:nth-child(2) {
        color: #444;
    }

    & > span:nth-child(3) {
        position: relative;
        top: 0.05em;
        left: 0.3em;
        cursor: pointer;

        &.default-delete {
            top: 0.2em;
            display: inline-block;
            width: 1em;
            height: 1em;
            opacity: 0.5;
            background-image: url(data:image/svg+xml;base64,);
            background-repeat: no-repeat;
            background-position: center;
            background-size: contain;
        }
    }
}
