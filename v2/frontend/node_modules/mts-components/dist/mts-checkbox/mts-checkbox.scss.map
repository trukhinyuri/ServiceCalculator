@import "../core/variables";
@import "../core/mixins";
@import "../core/cssreset";

section.mts-checkbox {

    & > [class ^= "control"] {
        @include font(1em, 1.5em);

        display: inline;
        cursor: pointer;

        &[class *= "--disabled"] {
            cursor: default;
            cursor: url(data:image/png;base64,), auto;
        }

        & > div {
            display: inline-block;
            vertical-align: top;

            &:first-child {
                width: 1.4em;

                & > input {
                    float: left;
                    width: 0;
                    height: 0;
                    margin: 0;
                    opacity: 0;
                }

                &:hover > input ~ .control_indicator,
                & > input:focus ~ .control_indicator {
                    border-color: $text-color-disabled !important;
                }

                & > input:checked ~ .control_indicator {
                    border-color: $color-disabled;
                }

                &:hover input:not([disabled]):checked ~ .control_indicator,
                & > input:checked:focus ~ .control_indicator {
                    background: white;
                }

                & > input:disabled ~ .control_indicator {
                    pointer-events: none;
                    background: #f2f3f7;
                    border-color: $color-disabled !important;
                }

                &:hover > input ~ .control_indicator:after,
                & > input:focus ~ .control_indicator:after {
                    border-color: #c90000;
                }

                & > input:checked ~ .control_indicator:after {
                    display: block;
                    opacity: 1;
                }

                & > input:disabled ~ .control_indicator:after {
                    border-color: $color-disabled;
                }

                & > .control_indicator {
                    width: 1.25em;
                    height: 1.25em;
                    transition: border-color $transition-primary, background $transition-primary;
                    border: 2px solid $color-disabled;
                    background: white;
                    border-radius: $border-radius-small;
                    box-sizing: content-box;

                    &:after {
                        display: block;
                        opacity: 0;
                        box-sizing: unset;
                        width: 0.25em;
                        height: 0.5em;
                        margin-top: 0.2em;
                        margin-left: 0.45em;
                        content: "";
                        transform: rotate(45deg);
                        border: solid $color-primary;
                        border-width: 0 3px 3px 0;
                        transition: border-color $transition-primary, opacity $transition-primary;
                    }
                }
            }

            &:last-child {
                max-width: calc(100% - 2em);
                padding-left: 0.75em;
            }
        }
    }
}
