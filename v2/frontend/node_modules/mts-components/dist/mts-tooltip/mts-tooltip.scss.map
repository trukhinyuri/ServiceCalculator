@import "../core/variables";
@import "../core/mixins";
@import "../core/cssreset";

:root {
    display: inline-block;
}

/* https://kazzkiq.github.io/balloon.css/*/

/**/
/* Variables*/
/* -----------------------------------------*/

$balloon-bg: fade-out(#1a2d41, 0.1) !default;
$balloon-base-size: 0.625em !default;
$balloon-arrow-height: 6px !default;

/**/
/* Mixins*/
/* -----------------------------------------*/

@mixin svg-arrow($color, $position: top) {
    $degrees: 0;
    $height: 6px;
    $width: 18px;

    @if ($position == bottom) {
        $degrees: 180 18 6;
    }

    @else if ($position == left) {
        $degrees: -90 18 18;
        $width: 6px;
        $height: 18px;
    }

    @else if ($position == right) {
        $degrees: 90 6 6;
        $width: 6px;
        $height: 18px;
    }

    @if (true) {
        width: $width;
        height: $height;
        background: no-repeat url("data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http://www.w3.org/2000/svg%22%20width%3D%22#{$width * 2}%22%20height%3D%22#{$height * 2}%22%3E%3Cpath%20fill%3D%22#{$color}%22%20transform%3D%22rotate(#{$degrees})%22%20d%3D%22M2.658,0.000%20C-13.615,0.000%2050.938,0.000%2034.662,0.000%20C28.662,0.000%2023.035,12.002%2018.660,12.002%20C14.285,12.002%208.594,0.000%202.658,0.000%20Z%22/%3E%3C/svg%3E");
        background-size: 100% auto;
    }
}

@mixin transition($args...) {
    -webkit-transition: $args;
    -moz-transition: $args;
    -ms-transition: $args;
    -o-transition: $args;
    transition: $args;
}

@mixin transform($val) {
    -webkit-transform: $val;
    -moz-transform: $val;
    -ms-transform: $val;
    transform: $val;
}

@mixin transform-origin($val) {
    -webkit-transform-origin: $val;
    -moz-transform-origin: $val;
    -ms-transform-origin: $val;
    transform-origin: $val;
}

@mixin opacity($trans) {
    opacity: $trans;
    filter: alpha(opacity=($trans * 100));
    -ms-filter: "progid:DXImageTransform.Microsoft.Alpha(Opacity=#{$trans * 100})";
    -moz-opacity: $trans;
    -khtml-opacity: $trans;
}

@mixin base-effects() {
    @include opacity(0);
    @include transition(all 0.18s ease-out 0.18s);

    pointer-events: none;
}

@mixin no-effects() {
    @include transition(none);
}

@mixin normalized-text() {
    font-family: $font-family !important;
    font-size: $balloon-base-size + 0.275 !important;
    font-weight: normal !important;
    font-style: normal !important;
    line-height: 1.3em;
    text-shadow: none !important;
}

section[class ^= "mts-tooltip"] {
    /**/
    /* Styles*/
    /* -----------------------------------------*/

    /* IE 11 button bugfix*/

    button[data-balloon] {
        overflow: visible;
    }

    [data-balloon] {
        position: relative; /* alt. absolute or fixed*/
        /* Fixing iOS Safari event issue.*/
        /* More info at: https://goo.gl/w8JF4W*/

        cursor: pointer;

        &:after {
            @include base-effects();
            @include normalized-text();

            position: absolute;
            z-index: 10;
            padding: 0.75em 1.5em 1em;
            content: attr(data-balloon);
            text-align: left;
            white-space: nowrap;
            color: #fff;
            border-radius: $border-radius;
            background: $balloon-bg;
        }

        &:before {
            @include svg-arrow($balloon-bg);
            @include base-effects();

            position: absolute;
            z-index: 10;
            content: "";
        }

        &:hover,
        &[data-balloon-visible] {

            &:before,
            &:after {
                @include opacity(1);

                pointer-events: auto;
            }
        }

        &:not([data-balloon-pos]) {

            &:after {
                @include transform(translate(-50%, 10px));
                @include transform-origin(top);

                bottom: 100%;
                left: 50%;
                margin-bottom: 5px + $balloon-arrow-height;
            }

            &:before {
                @include transform(translate(-50%, 10px));
                @include transform-origin(top);

                bottom: 100%;
                left: 50%;
                margin-bottom: 5px;
            }

            &:hover,
            &[data-balloon-visible] {

                &:after {
                    @include transform(translate(-50%, 0));
                }

                &:before {
                    @include transform(translate(-50%, 0));
                }
            }
        }

        &.font-awesome:after {
            font-family: FontAwesome;
        }

        &[data-balloon-break] {

            &:after {
                white-space: pre;
            }
        }

        &[data-balloon-blunt] {

            &:before,
            &:after {
                @include no-effects();
            }
        }

        &[data-balloon-pos = "top"] {

            &:after {
                @include transform(translate(-50%, 10px));
                @include transform-origin(top);

                bottom: 100%;
                left: 50%;
                margin-bottom: 5px + $balloon-arrow-height;
            }

            &:before {
                @include transform(translate(-50%, 10px));
                @include transform-origin(top);

                bottom: 100%;
                left: 50%;
                margin-bottom: 5px;
            }

            &:hover,
            &[data-balloon-visible] {

                &:after {
                    @include transform(translate(-50%, 0));
                }

                &:before {
                    @include transform(translate(-50%, 0));
                }
            }
        }

        &[data-balloon-pos = "top-left"] {

            &:after {
                @include transform(translate(0, 10px));
                @include transform-origin(top);

                bottom: 100%;
                left: 0;
                margin-bottom: 5px + $balloon-arrow-height;
            }

            &:before {
                @include transform(translate(0, 10px));
                @include transform-origin(top);

                bottom: 100%;
                left: 5px;
                margin-bottom: 5px;
            }

            &:hover,
            &[data-balloon-visible] {

                &:after {
                    @include transform(translate(0, 0));
                }

                &:before {
                    @include transform(translate(0, 0));
                }
            }
        }

        &[data-balloon-pos = "top-right"] {

            &:after {
                @include transform(translate(0, 10px));
                @include transform-origin(top);

                right: 0;
                bottom: 100%;
                margin-bottom: 5px + $balloon-arrow-height;
            }

            &:before {
                @include transform(translate(0, 10px));
                @include transform-origin(top);

                right: 5px;
                bottom: 100%;
                margin-bottom: 5px;
            }

            &:hover,
            &[data-balloon-visible] {

                &:after {
                    @include transform(translate(0, 0));
                }

                &:before {
                    @include transform(translate(0, 0));
                }
            }
        }

        &[data-balloon-pos = "bottom"] {

            &:after {
                @include transform(translate(-50%, -10px));

                top: 100%;
                left: 50%;
                margin-top: 5px + $balloon-arrow-height;
            }

            &:before {
                @include svg-arrow($balloon-bg, "bottom");
                @include transform(translate(-50%, -10px));

                top: 100%;
                left: 50%;
                margin-top: 5px;
            }

            &:hover,
            &[data-balloon-visible] {

                &:after {
                    @include transform(translate(-50%, 0));
                }

                &:before {
                    @include transform(translate(-50%, 0));
                }
            }
        }

        &[data-balloon-pos = "bottom-left"] {

            &:after {
                @include transform(translate(0, -10px));

                top: 100%;
                left: 0;
                margin-top: 5px + $balloon-arrow-height;
            }

            &:before {
                @include svg-arrow($balloon-bg, "bottom");
                @include transform(translate(0, -10px));

                top: 100%;
                left: 5px;
                margin-top: 5px;
            }

            &:hover,
            &[data-balloon-visible] {

                &:after {
                    @include transform(translate(0, 0));
                }

                &:before {
                    @include transform(translate(0, 0));
                }
            }
        }

        &[data-balloon-pos = "bottom-right"] {

            &:after {
                @include transform(translate(0, -10px));

                top: 100%;
                right: 0;
                margin-top: 5px + $balloon-arrow-height;
            }

            &:before {
                @include svg-arrow($balloon-bg, "bottom");
                @include transform(translate(0, -10px));

                top: 100%;
                right: 5px;
                margin-top: 5px;
            }

            &:hover,
            &[data-balloon-visible] {

                &:after {
                    @include transform(translate(0, 0));
                }

                &:before {
                    @include transform(translate(0, 0));
                }
            }
        }

        &[data-balloon-pos = "left"] {

            &:after {
                @include transform(translate(10px, -50%));

                top: 50%;
                right: 100%;
                margin-right: 5px + $balloon-arrow-height;
            }

            &:before {
                @include svg-arrow($balloon-bg, "left");
                @include transform(translate(10px, -50%));

                top: 50%;
                right: 100%;
                margin-right: 5px;
            }

            &:hover,
            &[data-balloon-visible] {

                &:after {
                    @include transform(translate(0, -50%));
                }

                &:before {
                    @include transform(translate(0, -50%));
                }
            }
        }

        &[data-balloon-pos = "right"] {

            &:after {
                @include transform(translate(-10px, -50%));

                top: 50%;
                left: 100%;
                margin-left: 5px + $balloon-arrow-height;
            }

            &:before {
                @include svg-arrow($balloon-bg, "right");
                @include transform(translate(-10px, -50%));

                top: 50%;
                left: 100%;
                margin-left: 5px;
            }

            &:hover,
            &[data-balloon-visible] {

                &:after {
                    @include transform(translate(0, -50%));
                }

                &:before {
                    @include transform(translate(0, -50%));
                }
            }
        }

        &[data-balloon-length = "small"] {

            &:after {
                width: 5em;
                white-space: normal;
            }
        }

        &[data-balloon-length = "medium"] {

            &:after {
                width: 9.375em;
                white-space: normal;
            }
        }

        &[data-balloon-length = "large"] {

            &:after {
                width: 16.25em;
                white-space: normal;
            }
        }

        &[data-balloon-length = "xlarge"] {

            &:after {
                width: 23.75em;
                white-space: normal;

                @media screen and (max-width: 48em) {
                    width: 90vw;
                    white-space: normal;
                }
            }
        }

        &[data-balloon-length = "fit"] {

            &:after {
                width: 100%;
                white-space: normal;
            }
        }
    }
}
