@import "../core/variables";
@import "../core/mixins";
@import "../core/cssreset";

section[class ^= "mts-button"] {

    & > button {
        @include font(1em, 1em);

        box-sizing: border-box;
        width: 100%;
        padding: 1em 1.5em;
        letter-spacing: 0.04em;
        cursor: pointer;
        user-select: none;
        transition: background-color $transition-primary, color $transition-primary, border-color $transition-primary;
        text-align: center;
        color: white;
        border: 2px solid transparent;
        border-radius: 0.375em;
        outline: none;
        background-color: $color-primary;

        &:hover,
        &:focus {
            outline: none;
            background-color: darken($color-primary, 7%);
        }

        /* colors*/

        &[class *= "--primary"] {
            background-color: $color-primary;

            &:hover,
            &:focus {
                background-color: #c90000;
            }
        }

        &[class *= "--secondary"] {
            background-color: $color-secondary;

            &:hover,
            &:focus {
                background-color: darken($color-secondary, 7%);
            }
        }

        &[class *= "--tertiary"] {
            background-color: $color-tertiary;

            &:hover,
            &:focus {
                background-color: darken($color-tertiary, 7%);
            }
        }

        &[class *= "--quaternary"] {
            background-color: $color-quaternary;

            &:hover,
            &:focus {
                background-color: darken($color-quaternary, 7%);
            }
        }

        &[class *= "--white"] {
            background-color: white;

            &:hover,
            &:focus {
                background-color: darken(white, 7%);
            }
        }

        &[class *= "--grey"] {
            background-color: $border-color;

            &:hover,
            &:focus {
                background-color: darken($border-color, 7%);
            }
        }

        &[class *= "--dark"] {
            background-color: $color-dark;

            &:hover,
            &:focus {
                background-color: #202d3d;
            }
        }

        /* format*/

        &[class *= "--fab"] {
            width: 2.4em;
            height: 2.4em;
            padding: 0.6em 0;
            min-width: unset;
            text-align: center;
            border-radius: 1.5em;
        }

        &[class *= "--extendedFab"] {
            padding: 0.6em 1.1em;
            border-radius: 1.5em;
        }

        /* variants*/

        &[class *= "--flat"] {
            color: $text-color-primary;
            background-color: transparent;

            &:hover,
            &:focus {
                background-color: $color-disabled;
            }
        }

        &[class *= "--outlined"] {
            color: $text-color-primary;
            border-color: $border-color;
            background-color: transparent;

            &:hover,
            &:focus {
                color: white;
                border-color: transparent;
                background-color: #001424;
            }
        }

        /* disabled*/

        &[class *= "--disabled"] {
            pointer-events: none;
            color: $text-color-disabled;
            background-color: $color-disabled;

            &:hover,
            &:focus {
                /* on mobile devices, hover effect sticks when using blur(),*/
                /* so we need neutral css settings for this case*/
                color: $text-color-disabled;
                border-color: transparent;
                background-color: $color-disabled;
            }
        }

        /* sizes*/

        &[class *= "--small"] {
            font-size: 0.875em;
            padding: (0.75em / 0.875) (1em / 0.875) (0.875em / 0.875);
            border-radius: ($border-radius-small / 0.875);
        }

        &[class *= "--large"] {
            font-size: 1.125em;
            padding: 1.25em 2.125em;
            border-radius: ($border-radius / 1.125);
        }
    }
}
