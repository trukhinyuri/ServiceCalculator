@import "../core/variables";
@import "../core/cssreset";

section.mts-switcher {
    $color-on: #26cd58;
    $color-off: #bbc1c7;
    $color-hover-on: #04aa42;
    $color-hover-off: #9198a0;

    [class ^= "switcher"] {
        position: relative;
        display: inline-block;
    }

    [class ^= "slider"] {
        cursor: pointer;
        background-color: $color-off;
        transition: $transition-primary;
        border-radius: 1em;
        width: 3.5em;
        height: 2em;

        &:before {
            position: absolute;
            content: "";
            left: 0.25em;
            bottom: 0.25em;
            background-color: white;
            transition: 0.4s;
            border-radius: 50%;
            height: 1.5em;
            width: 1.5em;
        }

        &:not(.disabled) {

            &:hover,
            &:focus {
                background-color: $color-hover-off;
            }
        }
    }

    .hidden-input {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        opacity: 0;
        width: 0;
        height: 0;
    }

    .hidden-input:checked + [class ^= "slider"] {
        background-color: $color-on;

        &:not(.disabled) {

            &:hover,
            &:focus {
                background-color: $color-hover-on;
            }
        }

        &:before {
            transform: translateX(1.5em);
        }
    }

    /* focus effect for keyboard users*/

    .hidden-input.hidden-input:focus + [class ^= "slider"]:not(.disabled) {
        background-color: $color-hover-off;
    }

    .hidden-input:checked.hidden-input:focus + [class ^= "slider"]:not(.disabled) {
        background-color: $color-hover-on;
    }

    /* disabled state*/

    [class ^= "slider"].disabled {
        background-color: $color-disabled;
    }

    .hidden-input:checked + [class ^= "slider"].disabled {
        opacity: 0.32;
    }

    /* sizes*/

    [class ^= "slider"][class *= "small"] {
        width: 2.75em;
        height: 1.5em;
    }

    [class ^= "slider"][class *= "small"]:before {
        height: 1em;
        width: 1em;
    }

    .hidden-input:checked + [class ^= "slider"][class *= "small"]:before {
        transform: translateX(1.25em);
    }
}
