@import "../../core/variables";
@import "../../core/mixins";
@import "../../core/cssreset";

:host {
    display: inline-block;
}

section[class ^= "mts-circular-progress"] {
    display: inline-block;

    /* colors*/

    &[class *= "--primary"] > svg,
    &[class *= "--default"] > svg {
        stroke: $color-primary;
    }

    &[class *= "--secondary"] > svg {
        stroke: $color-secondary;
    }

    &[class *= "--tertiary"] > svg {
        stroke: $color-tertiary;
    }

    &[class *= "--quaternary"] > svg {
        stroke: $color-quaternary;
    }

    &[class *= "--white"] > svg {
        stroke: #fff;
    }

    &[class *= "--grey"] > svg {
        stroke: $border-color;
    }

    /* variants*/

    &[class *= "--indeterminate"] {
        animation: mts-progress-circular-rotate 1.4s linear infinite;

        @keyframes mts-progress-circular-rotate {

            100% {
                transform: rotate(360deg);
            }
        }

        & > svg {
            animation: mts-progress-circular-dash 1.4s ease-in-out infinite;
            stroke-dasharray: 1em, 4em; /* length, distance*/
            stroke-dashoffset: 0;

            @keyframes mts-progress-circular-dash {

                0% {
                    stroke-dasharray: 0.01em, 4em; /* 0.01em for edge, if 0 then broken*/
                    stroke-dashoffset: 0;
                }

                50% {
                    stroke-dasharray: 3.4em, 0.6em;
                    stroke-dashoffset: -0.4em;
                }

                100% {
                    stroke-dasharray: 0.01em, 4em; /* 0.01em for edge, if 0 then broken*/
                    stroke-dashoffset: -4.1em;
                }
            }
        }
    }

    &[class *= "--determinate"] {
        transition: transform $transition-primary;

        & > svg {
            transition: stroke-dasharray $transition-primary, stroke-dashoffset $transition-primary;
        }
    }

    &[class *= "--static"] {
        transition: transform $transition-primary;

        & > svg {
            transition: stroke-dasharray $transition-primary, stroke-dashoffset $transition-primary;
        }
    }

    & > svg {
        width: 1em;
        height: 1em;
        transition: stroke $transition-primary;
        stroke: $color-primary;
    }
}
