@import "../../core/variables";
@import "../../core/mixins";
@import "../../core/cssreset";
$lighten-amount: 40%;

section[class ^= "mts-linear-progress"] {
    position: relative;
    overflow: hidden;
    height: 0.25em;
    background-color: lighten($color-primary, $lighten-amount + 10%);

    /* colors*/

    &[class *= "--primary"],
    &[class *= "--default"] {
        background-color: lighten($color-primary, $lighten-amount - 10%);

        & > div {
            background-color: $color-primary;
        }
    }

    &[class *= "--secondary"] {
        background-color: lighten($color-secondary, $lighten-amount);

        & > div {
            background-color: $color-secondary;
        }
    }

    &[class *= "--tertiary"] {
        background-color: lighten($color-tertiary, $lighten-amount);

        & > div {
            background-color: $color-tertiary;
        }
    }

    &[class *= "--quaternary"] {
        background-color: lighten($color-quaternary, $lighten-amount);

        & > div {
            background-color: $color-quaternary;
        }
    }

    &[class *= "--white"] {
        background-color: #ddd;

        & > div {
            background-color: white;
        }
    }

    &[class *= "--grey"] {
        background-color: lighten($text-color-disabled, $lighten-amount);

        & > div {
            background-color: $text-color-disabled;
        }
    }

    &[class *= "--indeterminate"],
    &[class *= "--query"] {

        & > .bar1 {
            width: auto;
            animation: mts-indeterminate1 2.1s cubic-bezier(0.65, 0.815, 0.735, 0.395) infinite;

            @keyframes mts-indeterminate1 {

                0% {
                    right: 100%;
                    left: -35%;
                }

                50% {
                    right: -90%;
                    left: 100%;
                }

                100% {
                    right: -90%;
                    left: 100%;
                }
            }
        }

        & > .bar2 {
            width: auto;
            animation: mts-indeterminate2 2.1s cubic-bezier(0.165, 0.84, 0.44, 1) infinite;
            animation-delay: 1.15s;

            @keyframes mts-indeterminate2 {

                0% {
                    right: 100%;
                    left: -200%;
                }

                50% {
                    right: -8%;
                    left: 107%;
                }

                100% {
                    right: -8%;
                    left: 107%;
                }
            }
        }

        & > .bar3 {
            display: none;
        }
    }

    &[class *= "--determinate"] {

        & > .bar2,
        & > .bar3 {
            display: none;
        }
    }

    &[class *= "--buffer"] {
        background-color: transparent;

        & > .bar1 {
            z-index: 2;
        }

        & > .bar2 {
            z-index: 1;
        }

        & > .bar3 {
            position: absolute;
            z-index: 0;
            width: 100%;
            height: 100%;
            margin-top: 0;
            animation: mts-indeterminate3 3s infinite linear;
            background-color: transparent;
            background-image: radial-gradient(lighten($color-primary, $lighten-amount - 10%) 0%, lighten($color-primary, $lighten-amount - 10%) 16%, transparent 42%);
            background-position: 0 -1em;
            background-size: 0.8em 0.8em;

            @keyframes mts-indeterminate3 {

                0% {
                    opacity: 1;
                    background-position: 0 -1.05em;
                }

                50% {
                    opacity: 0;
                    background-position: 0 -1.05em;
                }

                100% {
                    opacity: 1;
                    background-position: -15em -1.05em;
                }
            }
        }

        /* colors*/

        &[class *= "--primary"],
        &[class *= "--default"] {

            & > .bar2 {
                background-color: lighten($color-primary, $lighten-amount - 10%);
            }

            & > .bar3 {
                background-image: radial-gradient(lighten($color-primary, $lighten-amount - 10%) 0%, lighten($color-primary, $lighten-amount - 10%) 16%, transparent 42%);
            }
        }

        &[class *= "--secondary"] {

            & > .bar2 {
                background-color: lighten($color-secondary, $lighten-amount);
            }

            & > .bar3 {
                background-image: radial-gradient(lighten($color-secondary, $lighten-amount) 0%, lighten($color-secondary, $lighten-amount) 16%, transparent 42%);
            }
        }

        &[class *= "--tertiary"] {

            & > .bar2 {
                background-color: lighten($color-tertiary, $lighten-amount);
            }

            & > .bar3 {
                background-image: radial-gradient(lighten($color-tertiary, $lighten-amount) 0%, lighten($color-tertiary, $lighten-amount) 16%, transparent 42%);
            }
        }

        &[class *= "--quaternary"] {

            & > .bar2 {
                background-color: lighten($color-quaternary, $lighten-amount);
            }

            & > .bar3 {
                background-image: radial-gradient(lighten($color-quaternary, $lighten-amount) 0%, lighten($color-quaternary, $lighten-amount) 16%, transparent 42%);
            }
        }

        &[class *= "--white"] {

            & > .bar2 {
                background-color: $border-color;
            }

            & > .bar3 {
                background-image: radial-gradient(lighten($border-color, $lighten-amount) 0%, lighten($border-color, $lighten-amount) 16%, transparent 42%);
            }
        }

        &[class *= "--grey"] {

            & > .bar2 {
                background-color: lighten($text-color-disabled, $lighten-amount);
            }

            & > .bar3 {
                background-image: radial-gradient(lighten($text-color-disabled, $lighten-amount) 0%, lighten($text-color-disabled, $lighten-amount) 16%, transparent 42%);
            }
        }
    }

    &[class *= "--query"] {
        transform: rotate(180deg);
    }

    & > div {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 100%;
        transition: transform $transition-primary;
        transform-origin: left;
        background-color: $color-primary;
    }
}
