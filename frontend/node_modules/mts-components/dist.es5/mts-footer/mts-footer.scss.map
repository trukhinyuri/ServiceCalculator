@import "../core/variables";
@import "../core/mixins";
@import "../core/cssreset";

$color-gray-light: #f2f3f7;
$color-grey-chateau: #9198a0;
$color-white: #fff;
$color-lightest-blackberry: #e7eafa;
$color-grey-heather: #bbc1c7;

$color-facebook: #3b5998;
$color-vk: #4c6c91;
$color-ok: #f68634;
$color-twitter: #55acee;

mts-footer {
    display: block;
}

section.mts-footer {
    display: block;

    .home-footer-component {
        flex-basis: 50%;
        margin: 0 auto;
    }

    .container {
        display: block;

        &__promo {
            padding-top: 0.625em;
            flex-basis: 50%;
            width: auto;

            @media (min-width: $bigScreen) {
                flex-basis: auto;
                width: 50%;
            }

            @media (max-width: $middleScreen) {
                width: 50%;
                max-width: 21.875em;
            }

            @media (max-width: $smallScreen) {
                width: 100%;
                flex-basis: auto;
                margin-bottom: 1.5em;
            }

            h3 {
                font-weight: bold;
                font-size: 1.3em;
                text-align: left;
                color: $color-dark;
                margin: 0 0 0.5em 0;
                padding: 0;
                line-height: 1.3;
            }

            h4 {
                font-size: 1.15em;
                text-align: left;
                font-weight: normal;
                color: $color-dark;
                max-width: 23.75em;
                margin: 0;
                line-height: 1.5;
            }

            h5 {
                color: $color-dark;
                line-height: 1.4;
                margin: 1.5em 0 0 0;
                font-weight: normal;
                width: 23.75em;
                font-size: 0.9em;

                @media (max-width: $middleScreen) {
                    width: auto;
                }
            }
        }

        &__menu {
            overflow: hidden;
            flex-basis: auto;
            width: 50%;

            @media (min-width: $bigScreen) {
                flex-basis: auto;
                width: 40%;
                margin-left: auto;
            }

            @media (max-width: $middleScreen) {
                width: 100%;
            }

            ul {
                list-style: none;
                column-count: 2;
                margin: 0;
                padding: 0;

                li {
                    display: inline-block;
                    margin: 0.4em 0;
                    padding: 0;
                    width: 100%;
                    overflow: hidden;
                    text-align: left;
                    word-break: break-word;
                    white-space: normal;
                    line-height: 1.5;

                    a {
                        outline: 0;
                        text-decoration: none;
                        color: $color-grey-chateau;
                        transition: color 0.3s ease 0s, color 0.3s ease 0s;

                        &:hover {
                            text-decoration: none;
                            color: $color-primary;
                            opacity: 1;
                        }
                    }
                }
            }
        }
    }

    .content {
        color: $color-white;

        .cards .container {
            margin: 0 auto;

            &.container_first {
                display: flex;

                &:before {
                    display: block;
                    content: "";
                    position: absolute;
                    height: 1px;
                    left: 0;
                    right: 0;
                    background-color: $color-lightest-blackberry;
                    width: 100%;
                    margin-top: -2em;
                }
            }

            &.container_second {

                &:before {
                    display: block;
                    content: "";
                    position: absolute;
                    height: 1px;
                    left: 0;
                    right: 0;
                    background-color: $color-lightest-blackberry;
                    width: 100%;
                    margin-top: -2em;
                }

                .links {
                    display: flex;
                    flex-wrap: wrap;

                    h4 {
                        color: $color-dark;
                        font-weight: normal;
                        margin-bottom: 0;

                        @media (max-width: $smallScreen) {
                            margin-top: 0;
                        }
                    }

                    &__social {
                        width: auto;
                        margin-right: 4.25em;

                        @media (max-width: $bigScreen) {
                            flex-basis: 50%;
                            margin: auto;
                        }

                        @media (max-width: $smallScreen) {
                            flex-basis: auto;
                        }

                        @media (max-width: $middleScreen) {
                            width: 50%;
                        }

                        @media (max-width: $smallScreen) {
                            width: 100%;
                        }

                        .social-icons {
                            list-style: none;
                            margin: 1.25em 0;
                            padding: 0;

                            .social {
                                margin-right: 1.625em;

                                &:last-child {
                                    margin-right: 0;
                                }

                                a {
                                    overflow: hidden;
                                    display: inline-block;
                                }

                                svg {
                                    fill: $color-grey-heather;
                                    width: 2.5em;
                                    height: 2.5em;
                                    transition: fill $transition-primary;
                                }

                                &.facebook {
                                    width: 2.5em;
                                    height: 2.5em;
                                    display: inline-block;

                                    &:hover {

                                        svg {
                                            fill: $color-facebook;
                                        }
                                    }
                                }

                                &.vk {
                                    width: 2.5em;
                                    height: 2.5em;
                                    display: inline-block;

                                    &:hover {

                                        svg {
                                            fill: $color-vk;
                                        }
                                    }
                                }

                                &.ok {
                                    width: 2.5em;
                                    height: 2.5em;
                                    display: inline-block;

                                    &:hover {

                                        svg {
                                            fill: $color-ok;
                                        }
                                    }
                                }

                                &.twitter {
                                    width: 2.5em;
                                    height: 2.5em;
                                    display: inline-block;

                                    &:hover {

                                        svg {
                                            fill: $color-twitter;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    &__apps {
                        width: 33%;
                        margin-right: auto;

                        @media (max-width: $bigScreen) {
                            flex-basis: 50%;
                        }

                        @media (max-width: $middleScreen) {
                            width: 50%;
                        }

                        @media (max-width: $smallScreen) {
                            width: 100%;
                            flex-basis: auto;
                        }

                        &-btn-items {
                            display: flex;
                            margin: 1em 0;

                            @media (max-width: $smallScreen) {
                                flex-wrap: wrap;
                            }
                        }

                        &-btn-item {
                            margin-right: 2.5em;

                            .app-btn-item {
                                color: $color-dark;
                                overflow: hidden;
                                text-align: left;
                                display: flex;
                                align-items: center;
                                text-decoration: none;
                                line-height: 1.5em;

                                svg {
                                    width: 2.5em;
                                    height: 2.5em;
                                    fill: $color-grey-heather;
                                    transition: fill $transition-primary;
                                }

                                &.mts {

                                    &:hover {

                                        svg {
                                            fill: $color-primary;
                                        }
                                    }
                                }

                                &.cashback {

                                    &:hover {

                                        svg {
                                            fill: $color-primary;
                                        }
                                    }
                                }

                                &__icon {
                                    width: 2.5em;
                                    height: 2.5em;
                                    float: left;
                                    -webkit-transition: background-image 0.2s ease-in-out;
                                    transition: background-image 0.2s ease-in-out;
                                }

                                &__text {
                                    display: inline-block;
                                    margin-left: 1em;

                                    .link {
                                        color: $color-secondary;
                                    }
                                }
                            }
                        }
                    }

                    &__copyright {
                        flex-basis: 50%;

                        @media (min-width: $bigScreen) {
                            display: none;
                        }

                        @media (max-width: $smallScreen) {
                            flex-basis: 100%;
                            display: none;
                        }

                        .age-limit {
                            @media (max-width: $bigScreen) {
                                display: none;
                            }
                        }

                        .copyright {

                            br {
                                display: none;
                            }

                            @media (max-width: $bigScreen) {

                                br {
                                    display: block;
                                }
                            }
                        }
                    }

                    &__nav {
                        width: 40%;

                        @media (max-width: $smallScreen) {
                            flex-basis: 100%;
                        }

                        ul {
                            line-height: 1.5;
                            padding: 0;
                            list-style: none;
                            display: flex;
                            flex-wrap: wrap;
                            margin-top: 0.4375em;

                            li {
                                display: inline;
                                position: relative;
                                padding-right: 0.38em;
                                float: left;
                                line-height: 2;

                                &:first-child {
                                    flex-wrap: wrap;
                                }

                                &:last-child {
                                    flex-wrap: wrap;

                                    &:after {
                                        color: transparent;
                                    }
                                }

                                &:after {
                                    content: ".";
                                    color: $color-grey-chateau;
                                    font-weight: bold;
                                    vertical-align: super;
                                    margin-left: 0.375em;
                                    margin-right: 0;
                                    display: inline-block;
                                    top: 2px;
                                    position: relative;
                                }

                                a {
                                    outline: 0;
                                    text-decoration: none;
                                    color: $color-grey-chateau;
                                    transition: color 0.3s ease 0s, color 0.3s ease 0s;

                                    &:hover {
                                        text-decoration: none;
                                        color: $color-primary;
                                        opacity: 1;
                                    }
                                }
                            }
                        }
                    }
                }

                .second-copyrights {
                    display: flex;
                    justify-content: space-between;

                    @media (max-width: $bigScreen) {
                        display: none;
                    }

                    @media (max-width: $smallScreen) {
                        display: block;
                    }

                    .copyright {

                        .limit {
                            @media (min-width: $bigScreen) {
                                display: none;
                            }

                            @media (max-width: $smallScreen) {
                                display: inline-block;
                            }
                        }

                        br {
                            display: none;
                        }

                        @media (max-width: $bigScreen) {

                            br {
                                display: block;
                            }
                        }
                    }

                    .age-limit {
                        @media (max-width: $smallScreen) {
                            display: none;
                        }
                    }
                }
            }
        }

        .cards {
            text-align: left;

            .container {
                padding: 2em 0;

                @media (max-width: $middleScreen) {
                    padding: 1em;
                }

                &:first-child {
                    flex-wrap: wrap;

                    @media (max-width: $bigScreen) {
                        justify-content: space-between;
                    }

                    @media (max-width: $smallScreen) {
                        padding-bottom: 1.5em;
                    }
                }
            }
        }

        .copyright,
        .age-limit {
            display: block;
            padding: 1.375em 0 0 0.3125em;
            text-align: left;
            color: $color-grey-chateau;
            line-height: 1.5;
        }

        .age-limit {
            text-align: right;
        }
    }

    &.personal {
        padding: 1.375em 2em;

        .container {
            display: flex;
            align-items: center;
            color: $color-grey-chateau;

            @media (max-width: $smallScreen) {
                flex-wrap: wrap;
            }

            &__copyrights {
                width: 15%;
                margin-right: 2em;

                &.top {
                    @media (max-width: $smallScreen) {
                        display: none;
                    }
                }

                &.bottom {
                    display: none;

                    @media (max-width: $smallScreen) {
                        display: block;
                        margin-top: 1.5em;
                    }
                }

                @media (max-width: $bigScreen) {
                    width: 20%;
                    flex-basis: 15%;
                }

                @media (max-width: $middleScreen) {
                    flex-basis: 35%;
                    margin-right: auto;
                }

                @media (max-width: $smallScreen) {
                    flex-basis: 100%;
                }

                .age-limit {
                    margin-left: 1.125em;
                }
            }

            &__lmenu {
                width: 25%;
                margin-right: auto;
                display: block;

                a {
                    color: $color-secondary;
                    font-weight: bold;
                    text-decoration: none;
                    height: 1.5em;
                    line-height: 1.5em;
                    align-items: center;
                    display: block;
                    position: relative;

                    svg {
                        margin-left: 0.625em;
                        height: 0.75em;
                        top: 0.4375em;
                        position: absolute;
                    }
                }

                @media (max-width: $bigScreen) {
                    flex-basis: auto;
                    min-width: 12.5em;
                }

                @media (max-width: $middleScreen) {
                    display: none;
                }

                @media (max-width: $smallScreen) {
                    display: block;
                    flex-basis: 100%;
                    margin-bottom: 2em;
                    margin-right: 0;
                }
            }

            &__cmenu {
                display: flex;
                justify-content: flex-end;
                flex-direction: column;
                align-items: center;
                margin-right: 2.5em;

                a {
                    margin-left: 0.25em;
                    color: $color-secondary;
                    font-weight: bold;
                    text-decoration: none;
                    height: 1.5em;
                    line-height: 1.5em;
                    align-items: center;
                    display: inline-block;

                    svg {
                        margin-left: 0.625em;
                    }
                }

                > div {
                    width: 100%;
                    display: flex;
                    justify-content: flex-end;
                    text-align: right;
                }

                @media (max-width: $bigScreen) {
                    flex-basis: auto;
                    display: flex;
                    justify-content: flex-end;
                    flex-direction: column;
                }

                @media (max-width: $middleScreen) {
                    margin-right: 3.125em;
                }

                @media (max-width: $smallScreen) {
                    flex-basis: 100%;
                    align-items: normal;

                    a {
                        margin-left: 0;
                    }

                    margin-bottom: 2em;

                    > div {
                        width: 100%;
                        display: flex;
                        justify-content: flex-start;
                        text-align: left;
                    }
                }

                .question {
                    @media (max-width: $bigScreen) {
                        display: none;
                    }
                }
            }

            &__rmenu {
                display: flex;
                justify-content: flex-end;

                mts-button {

                    > * {
                        margin-right: 0.5em;
                    }
                }

                @media (max-width: $smallScreen) {
                    flex-basis: 100%;
                    justify-content: flex-start;

                    mts-button {
                        width: auto;
                    }
                }
            }
        }
    }
}
