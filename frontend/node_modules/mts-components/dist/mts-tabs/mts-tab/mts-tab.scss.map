@import "../../core/variables";
@import "../../core/mixins";

section[class ^= "mts-tab"]:not([class ^= "mts-tabs"]) {
    cursor: pointer;
    transition: color $transition-primary, background-color $transition-primary;

    &:hover > a > .label {
        color: $color-tertiary;
    }

    &[class *= "--disabled"] {
        pointer-events: none;
        opacity: 0.3;
    }

    &[class *= "--active"] {

        & > a > .label {
            color: $color-primary;
            -webkit-text-stroke-width: 0.4px; /* can't be animated ="(*/
        }
    }

    & > a {
        display: block;
        padding: 1.36em 1.25em;
        text-decoration: none;

        & > .label {
            @include font(1em);

            transition: color $transition-primary;
            color: #666;
        }
    }
}
