@import "../core/variables";
@import "../core/mixins";
@import "../core/cssreset";

section.mts-header {
    box-sizing: border-box;
    width: 100%;
    background-color: white;
    line-height: 1.3em;

    mts-logo {
        padding: 0.25em 0.7em 0.5em 0; /* min size for header*/
    }

    .separator {
        flex: 1 1 auto;
    }

    .right-block {

        & > div,
        & > a {
            display: inline-block;
            vertical-align: middle;
        }
    }

    .head-button {
        margin: 0;
        padding: 0.55em 0.5em 0.45em 0.5em;
        cursor: pointer;

        &:hover {

            & > svg {
                fill: #888;
            }

            & > span {
                color: $text-color-primary;
            }
        }

        & > svg {
            width: 1.8em;
            height: 1.8em;
            transition: fill $transition-primary;
            fill: #ccc;
            vertical-align: middle;
        }

        & > span {
            padding: 0 0.4em 0 0.5em;
            color: #aaa;
            vertical-align: middle;
            transition: color $transition-primary;
        }
    }

    .head-menu {

        a {
            text-decoration: none;
        }
    }

    .all-services {
        font: 700 1.03em/1em $font-family;
        display: block;
        padding: 1em 0;
        transition: color $transition-primary;
        text-align: center;
        text-decoration: none;
        color: $color-secondary;

        &:hover {
            color: $color-tertiary;
        }
    }

    .services {
        display: block;
        width: 19em;
        margin: 0;
        padding: 1em 1em;
        white-space: normal;

        .service {
            display: inline-block;
            box-sizing: border-box;
            width: 33%;
            min-height: 6.2em;
            margin: 0;
            padding: 0.9em 0 0.4em;
            text-align: center;
            cursor: pointer;
            transition: border $transition-primary;
            vertical-align: top;
            border: 1px solid transparent;
            border-radius: $border-radius-small;

            &:hover {

                & > a > span {
                    color: $color-tertiary;
                }
            }

            & > a {
                display: block;
                text-decoration: none;
                color: $text-color-primary;

                & > img,
                & > svg {
                    display: inline-block;
                    width: 2.2em;
                    height: 2.2em;
                }

                & > span {
                    font-size: 0.85em;
                    line-height: 1.3em;
                    display: inline-block;
                    width: 80%;
                    padding: 0.6em 0 0.5em;
                    transition: color $transition-primary;
                }
            }
        }
    }

    .avatar-menu {

        mts-divider {
            width: 78%;
            margin-left: 9%;

            @media (max-width: $smallScreen) {
                width: 90%;
                margin-left: 5%;
            }
        }

        .menu-line {
            @include font(1.1em, 1em);

            padding: 0.5em 0.5em;
            color: #666;
            box-sizing: border-box;

            & > svg {
                width: 1.6em;
                height: 1.6em;
                padding: 0 0.7em 0.2em 0.2em;
                vertical-align: middle;
                fill: #ccc;
            }

            .refill {
                text-decoration: none;
                float: right;
                padding: 0.25em 0.5em;
                color: $text-color-quaternary;
                box-sizing: border-box;
                transition: color $transition-primary;

                &:hover {
                    color: $color-tertiary;
                }
            }
        }

        & > .avatar,
        & > section > div > .avatar {
            width: 20em;
            padding: 1em 1.4em;
            box-sizing: content-box; /* todo: fix it*/

            & > div {
                display: inline-block;
                width: 25%;
                vertical-align: middle;

                &:last-of-type {
                    width: 74%;

                    & > div {
                        overflow: hidden;
                        white-space: nowrap;
                        text-overflow: ellipsis;

                        &:first-of-type {
                            font-weight: bolder;
                        }

                        &:last-of-type {
                            font-size: 0.9em;
                            padding-top: 0.5em;
                        }
                    }
                }
            }
        }
    }
}
